<?xml version="1.0" encoding="UTF-8"?>
<!-- Original WFF v2 composition. Coordinates use a 450 × 450 design canvas. -->
<WatchFace width="450" height="450">
  <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
  <Metadata key="PREVIEW_TIME" value="10:08:00"/>
  <UserConfigurations>
    <ColorConfiguration id="clockColor" defaultValue="aurora" displayName="Clock color" screenReaderText="Clock color">
      <ColorOption id="aurora" displayName="Aurora" colors="#B7F7D8"/><ColorOption id="ice" displayName="Ice" colors="#B9D7FF"/>
      <ColorOption id="coral" displayName="Coral" colors="#FFB4A2"/><ColorOption id="violet" displayName="Violet" colors="#D7C2FF"/>
      <ColorOption id="lime" displayName="Lime" colors="#D7F58A"/><ColorOption id="amber" displayName="Amber" colors="#FFD08A"/>
      <ColorOption id="rose" displayName="Rose" colors="#FFB1C8"/><ColorOption id="mist" displayName="Mist" colors="#E4E8EF"/>
    </ColorConfiguration>
    <ColorConfiguration id="accentColor" defaultValue="aurora" displayName="Accent color" screenReaderText="Accent color">
      <ColorOption id="aurora" displayName="Aurora" colors="#55D995"/><ColorOption id="ice" displayName="Ice" colors="#6FA8FF"/>
      <ColorOption id="coral" displayName="Coral" colors="#FF7F6A"/><ColorOption id="violet" displayName="Violet" colors="#A987FF"/>
      <ColorOption id="lime" displayName="Lime" colors="#A6D936"/><ColorOption id="amber" displayName="Amber" colors="#F0A83A"/>
      <ColorOption id="rose" displayName="Rose" colors="#E96791"/><ColorOption id="mist" displayName="Mist" colors="#AAB5C4"/>
    </ColorConfiguration>
    <ListConfiguration id="aodStyle" defaultValue="dimmed" displayName="Always-on style" screenReaderText="Always-on style">
      <ListOption id="dimmed" displayName="Dimmed"/><ListOption id="timeOnly" displayName="Time only"/><ListOption id="large" displayName="Enlarged time"/>
    </ListConfiguration>
    <BooleanConfiguration id="seconds" defaultValue="FALSE" displayName="Seconds indicator" screenReaderText="Seconds indicator"/>
    <ListConfiguration id="wideTextSize" defaultValue="22" displayName="Top and bottom text size" screenReaderText="Top and bottom text size"><ListOption id="18" displayName="18"/><ListOption id="22" displayName="22"/><ListOption id="26" displayName="26"/></ListConfiguration>
    <Flavors defaultValue="daily">
      <Flavor id="daily" displayName="Daily"><Configuration id="clockColor" optionId="aurora"/><Configuration id="accentColor" optionId="aurora"/><Configuration id="aodStyle" optionId="dimmed"/><Configuration id="seconds" optionId="FALSE"/><Configuration id="wideTextSize" optionId="22"/></Flavor>
      <Flavor id="focus" displayName="Focus"><Configuration id="clockColor" optionId="ice"/><Configuration id="accentColor" optionId="ice"/><Configuration id="aodStyle" optionId="timeOnly"/><Configuration id="seconds" optionId="FALSE"/><Configuration id="wideTextSize" optionId="18"/></Flavor>
      <Flavor id="signal" displayName="Signal"><Configuration id="clockColor" optionId="amber"/><Configuration id="accentColor" optionId="coral"/><Configuration id="aodStyle" optionId="large"/><Configuration id="seconds" optionId="TRUE"/><Configuration id="wideTextSize" optionId="26"/></Flavor>
      <Flavor id="quiet" displayName="Quiet"><Configuration id="clockColor" optionId="mist"/><Configuration id="accentColor" optionId="mist"/><Configuration id="aodStyle" optionId="dimmed"/><Configuration id="seconds" optionId="FALSE"/><Configuration id="wideTextSize" optionId="22"/></Flavor>
    </Flavors>
  </UserConfigurations>
  <Scene backgroundColor="#101216">
    <ComplicationSlot x="76" y="176" width="82" height="82" slotId="0" displayName="Day and date" supportedTypes="SHORT_TEXT EMPTY">
      <DefaultProviderPolicy defaultSystemProvider="DAY_AND_DATE" defaultSystemProviderType="SHORT_TEXT"/>
      <BoundingOval x="0" y="0" width="82" height="82" outlinePadding="2"/>
      <Complication type="SHORT_TEXT"><PartText x="0" y="4" width="82" height="70"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="20" color="[CONFIGURATION.clockColor.0]"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText></Complication>
    </ComplicationSlot>
    <ComplicationSlot x="292" y="176" width="82" height="82" slotId="1" displayName="Calendar progress" supportedTypes="RANGED_VALUE SHORT_TEXT LONG_TEXT EMPTY">
      <BoundingOval x="0" y="0" width="82" height="82" outlinePadding="2"/>
      <Complication type="RANGED_VALUE">
        <PartDraw x="3" y="3" width="76" height="76"><Arc direction="CLOCKWISE" startAngle="-90" endAngle="270" centerX="38" centerY="38" width="70" height="70"><Stroke thickness="3" color="#3A404A" cap="ROUND"/></Arc><Arc direction="CLOCKWISE" startAngle="-90" endAngle="270" centerX="38" centerY="38" width="70" height="70"><Stroke thickness="4" color="[CONFIGURATION.accentColor.0]" cap="ROUND"/><Transform target="endAngle" value="-90 + (clamp([COMPLICATION.RANGED_VALUE_VALUE], [COMPLICATION.RANGED_VALUE_MIN], [COMPLICATION.RANGED_VALUE_MAX]) - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]) * 360"/></Arc></PartDraw>
        <PartDraw x="3" y="3" width="76" height="76" alpha="255"><Variant mode="AMBIENT" target="alpha" value="0"/><Line x1="38" y1="38" x2="38" y2="11"><Stroke thickness="3" color="[CONFIGURATION.accentColor.0]" cap="ROUND"/><Transform target="angle" value="-90 + (clamp([COMPLICATION.RANGED_VALUE_VALUE], [COMPLICATION.RANGED_VALUE_MIN], [COMPLICATION.RANGED_VALUE_MAX]) - [COMPLICATION.RANGED_VALUE_MIN]) / ([COMPLICATION.RANGED_VALUE_MAX] - [COMPLICATION.RANGED_VALUE_MIN]) * 360"/></Line></PartDraw>
        <PartText x="8" y="28" width="66" height="26"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="16" color="[CONFIGURATION.clockColor.0]"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText>
      </Complication>
      <Complication type="SHORT_TEXT"><PartDraw x="3" y="3" width="76" height="76"><Arc startAngle="0" endAngle="360" centerX="38" centerY="38" width="70" height="70"><Stroke thickness="3" color="#3A404A"/></Arc></PartDraw><PartText x="6" y="22" width="70" height="34"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="16" color="[CONFIGURATION.clockColor.0]"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText></Complication>
      <Complication type="LONG_TEXT"><PartDraw x="3" y="3" width="76" height="76"><Arc startAngle="0" endAngle="360" centerX="38" centerY="38" width="70" height="70"><Stroke thickness="3" color="#3A404A"/></Arc></PartDraw><PartText x="6" y="22" width="70" height="34"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="14" color="[CONFIGURATION.clockColor.0]"><Template>%s<Parameter expression="[COMPLICATION.TEXT]"/></Template></Font></Text></PartText></Complication>
    </ComplicationSlot>
    <DigitalClock x="80" y="132" width="290" height="186"><TimeText x="0" y="0" width="290" height="92" format="HH" hourFormat="SYNC_TO_DEVICE" align="CENTER"><Font family="orbitron_wght" size="102" weight="MEDIUM" color="[CONFIGURATION.clockColor.0]"/></TimeText><TimeText x="0" y="80" width="290" height="92" format="mm" hourFormat="SYNC_TO_DEVICE" align="CENTER"><Font family="orbitron_wght" size="102" weight="MEDIUM" color="[CONFIGURATION.clockColor.0]"/></TimeText></DigitalClock>
    <BooleanConfiguration id="seconds"><BooleanOption id="TRUE"><PartText x="211" y="307" width="34" height="22"><Text align="CENTER"><Font family="SYNC_TO_DEVICE" size="14" color="[CONFIGURATION.accentColor.0]"><Template>%s<Parameter expression="[SECOND]"/></Template></Font></Text></PartText></BooleanOption></BooleanConfiguration>
    <ComplicationSlot x="45" y="42" width="360" height="52" slotId="2" displayName="Top text" supportedTypes="SHORT_TEXT LONG_TEXT EMPTY"><BoundingArc centerX="180" centerY="180" width="360" height="360" startAngle="205" endAngle="335" thickness="52"/><Complication type="SHORT_TEXT"><PartText x="0" y="0" width="360" height="52"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="22" color="[CONFIGURATION.clockColor.0]"><Template>%s  %s<Parameter expression="[COMPLICATION.TEXT]"/><Parameter expression="[COMPLICATION.TITLE]"/></Template></Font></Text></PartText></Complication><Complication type="LONG_TEXT"><PartText x="0" y="0" width="360" height="52"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="22" color="[CONFIGURATION.clockColor.0]"><Template>%s  %s<Parameter expression="[COMPLICATION.TEXT]"/><Parameter expression="[COMPLICATION.TITLE]"/></Template></Font></Text></PartText></Complication></ComplicationSlot>
    <ComplicationSlot x="45" y="363" width="360" height="52" slotId="3" displayName="Bottom text" supportedTypes="SHORT_TEXT LONG_TEXT EMPTY"><BoundingArc centerX="180" centerY="-90" width="360" height="360" startAngle="25" endAngle="155" thickness="52"/><Complication type="SHORT_TEXT"><PartText x="0" y="0" width="360" height="52"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="22" color="[CONFIGURATION.clockColor.0]"><Template>%s  %s<Parameter expression="[COMPLICATION.TEXT]"/><Parameter expression="[COMPLICATION.TITLE]"/></Template></Font></Text></PartText></Complication><Complication type="LONG_TEXT"><PartText x="0" y="0" width="360" height="52"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="22" color="[CONFIGURATION.clockColor.0]"><Template>%s  %s<Parameter expression="[COMPLICATION.TEXT]"/><Parameter expression="[COMPLICATION.TITLE]"/></Template></Font></Text></PartText></Complication></ComplicationSlot>
  </Scene>
</WatchFace>
